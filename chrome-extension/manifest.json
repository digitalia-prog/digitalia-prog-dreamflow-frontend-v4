{
  "manifest_version": 3,
  "name": "UGC Growth",
  "version": "0.1.0",
  "description": "Analysez une publicité avec UGC Growth depuis les bibliothèques publicitaires.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://www.facebook.com/ads/library/*",
    "https://ads.tiktok.com/business/creativecenter/*",
    "https://www.youtube.com/*",
    "http://localhost:3000/*",
    "https://ugcgrowth.io/*",
    "https://ads.tiktok.com/creativecenter/*",
    "https://ads.tiktok.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/ads/library/*"
      ],
      "js": [
        "content-meta.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ads.tiktok.com/business/creativecenter/*",
        "https://ads.tiktok.com/creativecenter/*",
        "https://ads.tiktok.com/*"
      ],
      "js": [
        "content-tiktok.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content-youtube.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "UGC Growth"
  }
}
